{
  "name": "tracr-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for tracr. Published packages live under packages/.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "build:ui": "pnpm --filter @pablo_clueless/ui build",
    "clean": "tsc -b --clean && cargo clean",
    "typecheck": "tsc -b && pnpm --filter @pablo_clueless/ui --filter \"./examples/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "core:build": "cargo build -p tracr-core",
    "core:test": "cargo test -p tracr-core",
    "core:fixtures": "node scripts/gen-wire-fixtures.mjs",
    "ui:dev": "pnpm --filter @pablo_clueless/ui dev",
    "example:react": "pnpm --filter @pablo_clueless/example-react-vite dev",
    "example:vue": "pnpm --filter @pablo_clueless/example-vue-vite dev",
    "example:express": "pnpm --filter @pablo_clueless/example-express-api dev",
    "gate": "pnpm --filter @pablo_clueless/babel-plugin gate",
    "bench": "node scripts/bench-express.mjs && node scripts/bench-hmr.mjs",
    "bench:express": "node scripts/bench-express.mjs",
    "bench:hmr": "node scripts/bench-hmr.mjs",
    "core:sites": "node scripts/gen-site-fixture.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.6"
    }
  }
}
