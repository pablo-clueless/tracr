{
  "name": "tracr",
  "version": "0.0.0",
  "description": "Value-level provenance tracing. Install as a devDependency.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tracr": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/loader.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@babel/core": "^7.28.0",
    "@tracr/babel-plugin": "workspace:*",
    "@tracr/protocol": "workspace:*",
    "@tracr/runtime": "workspace:*"
  }
}
