{
  "name": "@pablo_clueless/react",
  "version": "0.0.0",
  "description": "React adapter for tracr: sources, sinks, and hook shims.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shim": {
      "types": "./dist/shim.d.ts",
      "default": "./dist/shim.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@pablo_clueless/protocol": "workspace:*",
    "@pablo_clueless/runtime": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "react": "^19.2.8",
    "@types/react": "^19.2.8"
  }
}
